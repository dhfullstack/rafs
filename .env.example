# Copie para .env e preencha. NUNCA commite o .env.

# Modo: PAPER (padrão, simulado local), TESTNET (ordens na testnet, dinheiro fictício), FUTURES (demo de futuros,
# compra e short a 1x, dinheiro fictício) ou BACKTEST. LIVE não existe neste MVP.
MODE=PAPER

# --- Mercado (dados públicos, não precisa de chave) ---
EXCHANGE=binance
SYMBOLS=BTC/BRL,ETH/BRL,SOL/BRL
# candle que a corretora não tem (ex.: 2m na Binance) é montado a partir do 1m
TIMEFRAME=15m
POLL_SECONDS=30

# --- Capital e limites (por carteira simulada, em BRL) ---
CAPITAL_BRL=200
ENTRY_BRL=15
MAX_EXPOSURE_BRL=50
DAILY_LOSS_LIMIT_BRL=10
MAX_POSITIONS_PER_SYMBOL=1

# --- Saídas determinísticas (iguais para todos os deciders) ---
STOP_ATR_MULT=2.0
TAKE_PROFIT_ATR_MULT=3.0
MAX_HOLD_CANDLES=32
# piso do stop em % (0 = só ATR). Escala stop e alvo juntos: em candle curto evita stop do tamanho da taxa
MIN_STOP_PCT=0
# depois de um stop, o book fica N candles sem entrar de novo no mesmo ativo (evita o vai e volta); 0 = desliga
STOP_COOLDOWN_CANDLES=0

# --- Custos simulados ---
FEE_RATE=0.001
SLIPPAGE_BPS=5

# --- Jev (iajev.com) ---
# Crie a chave em https://iajev.com (configurações da conta). Sem a chave, o decider Jev fica desligado.
JEV_API_KEY=
JEV_MIN_PROBABILITY=0.6
# 0 = ilimitado. Se os créditos acabarem, a API devolve 402 e o decider Jev se desliga sozinho.
JEV_MAX_CALLS_PER_DAY=0
# Filtro de tendência: sem posição, só pergunta ao Jev se EMA12 > EMA26 (poupa chamadas e evita HTTP 429).
# 0 = consulta o Jev em todo candle.
JEV_TREND_GATE=1
# trend = o Jev avalia entradas no lado da EMA; fade = só quando o preço está a FADE_MIN_DEV_PCT % ou mais
# da VWAP48, apostando na volta à média (compra abaixo, short acima). Backtest 60d 15m (SIMULADO), entradas
# aleatórias: a favor da EMA 29% de acerto, fade de 1% 40%. Nenhum dos dois cobre as taxas sozinho: o Jev precisa somar.
# JEV_ENTRY_STYLE=trend
# FADE_MIN_DEV_PCT=1.0
# v2 (padrão): pergunta "o preço bate o alvo antes do stop?" e compra se a chance passar do ponto de
# equilíbrio (alvo, stop, taxas e slippage) + JEV_EDGE_MARGIN. v1: pergunta BUY/HOLD com JEV_MIN_PROBABILITY.
JEV_PROMPT_VERSION=v2
# Teto de chamadas por hora (0 = sem teto), somando todas as chaves: elas dividem a cota da conta
# (~89/dia observado em 30/10, limite não documentado). Com 4/h e JEV_MAX_CALLS_PER_DAY=80 o Jev dura o dia todo.
JEV_MAX_CALLS_PER_HOUR=8
JEV_EDGE_MARGIN=0.03

# Grok (xAI) — CHIEF: lê mercado e operações e só escala ao Jev o que importa. Chave em console.x.ai.
# Vazio = Grok desligado e o Jev é consultado direto.
XAI_API_KEY=
GROK_MODEL=grok-4.20-0309-non-reasoning
# ~US$ 0,001 por leitura no modelo padrão; 0 = sem limite
GROK_MAX_CALLS_PER_DAY=400
# entrada com score (chance de alvo antes do stop) >= isso vai ao Jev mesmo sem escalate; 0 = desliga
GROK_MIN_SCORE=0

# --- Mesa (guia "The Hedge Fund Terminal") ---
# 1 = o dial do QUANT vale para todos os books: sem dial publicado, dial crypto < 0.50 ou par fora dos alvos
# de momentum 12-1, nenhuma entrada (NO DIAL, NO DESK) e o ticket é multiplicado pelo dial.
# 0 = só o RISK da conta (−4% no dia → FLAT) e a checagem do CHIEF valem para os books de 15m.
DESK_RULES=1
# 1 = cria o book "quant": rotação 12-1 top 2 × dial às 20:05 de Nova York, sem LLM (o sleeve crypto do guia).
QUANT_BOOK=1

# --- Memecoins (PAPER, banca SIMULADA; nunca envia ordem) ---
# SCAN no GeckoTerminal → Grok separa → Jev escolhe um ou nenhum → Kelly × dial meme → fill simulado → RISK 5 min
MEME_SLEEVE=1
MEME_BANK_USD=10000
MEME_NETS=solana,bsc
MEME_TAKE_PROFIT_PCT=50
MEME_STOP_PCT=25
MEME_MAX_HOLD_HOURS=24
MEME_MAX_POSITIONS=3
# 2 chamadas ao Jev por escolha; o teto por hora é o mesmo JEV_MAX_CALLS_PER_HOUR (memes usam até metade)
MEME_JEV_MAX_CALLS_PER_DAY=60
MEME_GROK_MAX_CALLS_PER_DAY=120

# --- Telegram (opcional) ---
# Crie o bot com o @BotFather e descubra seu chat id com @userinfobot.
# MODE=TESTNET: ordens reais na Binance Spot Testnet (dinheiro fictício).
# Chave grátis em https://testnet.binance.vision (login com GitHub → Generate HMAC_SHA256 Key).
# Não é a chave da sua conta Binance real — essa NUNCA deve ir aqui.
TESTNET_API_KEY=
TESTNET_API_SECRET=
# Pares só da testnet (a conta fictícia vem com ~10.000 USDT e pouco BRL). Vazio = usa SYMBOLS.
TESTNET_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT

# MODE=FUTURES: Binance Futures DEMO (USDT-M), compra (long) e venda a descoberto (short) a 1x, margem isolada.
# Chave em https://demo.binance.com → API Management. Conta demo, dinheiro fictício — NUNCA a chave da conta real.
FUTURES_API_KEY=
FUTURES_API_SECRET=
FUTURES_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
# Banca própria em USDT (só no FUTURES; PAPER/TESTNET seguem CAPITAL_BRL etc.)
FUTURES_CAPITAL=1000
FUTURES_ENTRY=100
FUTURES_MAX_EXPOSURE=300
FUTURES_DAILY_LOSS_LIMIT=50
# Taxa taker da Binance Futures (0,05%); funding não entra no P&L
FUTURES_FEE_RATE=0.0005

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Armazenamento ---
DATA_DIR=data

# --- Discord (opcional, só notificações) ---
# Canal → Editar canal → Integrações → Webhooks → Novo webhook → Copiar URL
DISCORD_WEBHOOK_URL=

# --- Painel web (python -m rafs dashboard  ou  run --dashboard) ---
# Senha do painel. Vazio = o bot gera uma aleatória e salva em data/dashboard_password.txt
DASHBOARD_PASSWORD=
DASHBOARD_PORT=8787
